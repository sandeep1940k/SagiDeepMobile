# Playlists: Google Sheet tab "PlayList" (CSV via gviz). See `loadPlaylistsFromSheet` in src/data/playlists.js.
# VITE_PLAYLIST_SHEET_ID=
# VITE_PLAYLIST_SHEET_NAME=
# Set to 0 to skip fetch (playlists stay empty).
# VITE_PLAYLIST_SHEET_ENABLED=

# Optional. Live subscriber / view counts from YouTube Data API v3.
# Without a key, use `manualStatsLine` in src/data/youtubeChannel.js instead.
# Create: Google Cloud Console → YouTube Data API v3 → Credentials → API key
VITE_YOUTUBE_API_KEY=

# Footer promo: same Apps Script as SHEET_URL in src/config/config.js — POST action "footerPromo" (sheet cols I,J,K). See footerPromoSheet.js.
# Optional legacy CSV instead of web app:
# VITE_FOOTER_PROMO_SHEET_CSV_URL=
# Optional web app action name (default footerMobileUpdate):
# VITE_FOOTER_PROMO_ACTION=
# Set to 0 to use static footer fields from src/data/youtubeChannel.js only (no fetch).
# VITE_FOOTER_PROMO_SHEET_ENABLED=
